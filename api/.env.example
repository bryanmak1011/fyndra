# Copy to .env and fill in. Never commit .env.

# Local Docker default (see docker-compose.yml). Override for local (non-Docker) dev, e.g.:
# postgresql://fyndra@localhost:5432/fyndra
DATABASE_URL=postgresql://fyndra:fyndra@localhost:5432/fyndra

# One of these, matching LLM_PROVIDER below.
#
# OpenRouter (recommended for dev — free-tier model available) is
# OpenAI-compatible: set OPENAI_API_KEY to your OpenRouter key,
# OPENAI_BASE_URL to https://openrouter.ai/api/v1, and LLM_MODEL to the
# model slug, e.g. nvidia/nemotron-3.5-lightning:free. That model is a
# reasoning model — it emits substantial chain-of-thought before its
# answer, so calls can take 30-90s; account for that in any timeout that
# wraps an LLM call (see tests/integration/cv-interpret-live.test.ts).
LLM_PROVIDER=openai-compatible
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=

# Typesafe AI (Jev) — proposed for choice-field answer drafting in
# apply/prefill.ts (T093), not called from any code yet. Pending
# Architecture Board review 2026-09-21 — see research.md / BLOCKERS.md.
TYPESAFE_API_KEY=

# Only needed once a JS-gated source is onboarded (see SDD.md §6.3).
FIRECRAWL_API_KEY=

# Apify (https://apify.com) — used to source JobsDB HK and 104.com.tw
# postings via third-party actors, since neither site has a workable
# direct-fetch path (see BLOCKERS.md). Get a token from
# https://console.apify.com/settings/integrations.
APIFY_API_TOKEN=

# CV storage (compliance/privacy-policy-requirements.md — PII-partitioned,
# encrypted at rest). Generate with: openssl rand -hex 32
CV_ENCRYPTION_KEY=
CV_STORAGE_DIR=data/cv-storage

# Browser-automation submission (api/src/browser-agent) — drives JobsDB
# HK's / 104.com.tw's own native apply flow with a headless (or headed,
# for capture/debugging) browser. Personal-test scope only: see
# compliance/risk-acceptance-log.md's 2026-09-10 entry and SDD.md R13
# before touching any of this. Leave BROWSER_AUTOMATION_ENABLED unset/false
# in any environment other than your own local dev machine.
#
# Separate encryption key from CV_ENCRYPTION_KEY — a leaked session-state
# key exposes a live authenticated account session, not just documents.
# Generate with: openssl rand -hex 32
SESSION_STATE_ENCRYPTION_KEY=
SESSION_STATE_STORAGE_DIR=data/session-state
BROWSER_AUTOMATION_ENABLED=false
# The one UserProfile.id this is allowed to act on. Find yours with:
# psql "$DATABASE_URL" -c "select id, email from \"UserProfile\";"
BROWSER_AUTOMATION_TEST_PROFILE_ID=
# false while developing/verifying selectors so you can watch it click;
# true for normal unattended worker runs.
BROWSER_AUTOMATION_HEADLESS=true

# APNs push (server.md §6.8 / FR-029). Leave blank in local dev; push is a no-op without it.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.fyndra.app
APNS_PRIVATE_KEY_PATH=

# Bearer token lifetime, in days (SDD §6.2).
AUTH_TOKEN_TTL_DAYS=30

PORT=3000
NODE_ENV=development
